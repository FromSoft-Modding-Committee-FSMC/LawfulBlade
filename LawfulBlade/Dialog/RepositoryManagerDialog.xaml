<Window x:Class="LawfulBlade.Dialog.RepositoryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LawfulBlade.Dialog"
        mc:Ignorable="d"
        Title="Lawful Blade - Repository Manager" Height="480" Width="640" Background="#FF202020"
        Icon="{StaticResource lbIcon}" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel Margin="8,8,8,8">
        <StackPanel Orientation="Vertical" DockPanel.Dock="Top">

            <!-- Dialog Label -->
            <TextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFF0F0F0" FontSize="22" FontWeight="Bold" Margin="0,8,0,16">
            Repository Manager
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" Background="#202020" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="repositoryList" Orientation="Vertical" />
                </ScrollViewer>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="44.7366666666667"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="urlField" Grid.Column="0" AcceptsReturn="True" HorizontalAlignment="Stretch" Background="#FF101010" BorderBrush="Black" Foreground="#FFF0F0F0" Margin="0,2,0,2"/>
                <Button x:Name="deleteButton" Grid.Column="2" Margin="2,2,2,2" Click="OnClickAdd">
                    <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Center">Add</TextBlock>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Button Array -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" DockPanel.Dock="Bottom">
            <Button Margin="0,0,4,0" Background="#FF308FA0" Click="OnClickClose">
                <TextBlock Margin="4,0,4,0">Close</TextBlock>
            </Button>
        </StackPanel>
    </DockPanel>
</Window>
